{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "excalidraw-full",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "containers": [
    {
      "class_name": "ExcalidrawContainer",
      // built from this repo (frontend submodule included), not the upstream
      // image, so deploys carry our changes
      "image": "../excalidraw-complete.Dockerfile",
      "image_build_context": "..",
      "max_instances": 3,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EXCALIDRAW_CONTAINER",
        "class_name": "ExcalidrawContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ExcalidrawContainer"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "CANVAS_BUCKET",
      "bucket_name": "excali-bucket"
    }
  ],
  "vars": {
    "STORAGE_TYPE": "s3",
    "S3_BUCKET_NAME": "excali-bucket",
    "AWS_REGION": "auto",
    // Cloudflare Access in front of the domain logs users in (see README)
    "CF_ACCESS_TEAM_DOMAIN": "https://falling-truth-89ff.cloudflareaccess.com",
    "CF_ACCESS_AUD": "e19d738a0e3f11a6519f01f35e8818e31db26cdb857865a56fb8f679985c9d37"
  },
  "routes": [
    {
      "pattern": "excali.vladislav.cc",
      "custom_domain": true
    }
  ]
}
